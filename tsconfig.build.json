{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@quiet/types": ["packages/types/lib"],
      "@quiet/common": ["packages/common/lib"],
      "@quiet/logger": ["packages/logger/lib"],
      "@quiet/identity": ["packages/identity/lib"],
      "@quiet/node-common": ["packages/node-common/lib"],
      "@quiet/state-manager": ["packages/state-manager/lib"],
      "@quiet/backend": ["packages/backend/lib"],
      "@quiet/helia": ["packages/helia/lib"]
    },
    "target": "ES2020",
    "module": "commonjs",
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "typeRoots": [
      "./packages/@types",
      "./node_modules/@types",
      "./3rd-party/auth/packages/**/src"
    ],
    "lib": [
      "ES2020",
      "DOM.Iterable",
      "dom",
      "ES2021.String",
      "ES2015"
    ]
  }
}
