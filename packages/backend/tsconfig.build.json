{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "strict": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "useUnknownInCatchVariables": false,
    "strictPropertyInitialization": false,
    "rootDir": "./src",
    "outDir": "./lib",
    "baseUrl": ".",
    "paths": {
      "helia": ["../helia/lib"],
      "@quiet/types": ["../types/lib"],
      "@quiet/common": ["../common/lib"],
      "@quiet/logger": ["../logger/lib"],
      "@quiet/identity": ["../identity/lib"],
      "@quiet/state-manager": ["../state-manager/lib"],
      "@quiet/node-common": ["../node-common/lib"],
      "3rd-party/auth/packages/auth/dist": ["../../3rd-party/auth/packages/auth/dist"],
      "3rd-party/auth/packages/auth/dist/connection/Connection": ["../../3rd-party/auth/packages/auth/dist/connection/Connection"]
    },
    "typeRoots": [
      "../@types",
      "./node_modules/@types",
      "./3rd-party/auth/packages/auth/src",
      "./3rd-party/auth/packages/crdx/src",
      "./3rd-party/js-libp2p-noise/src"
    ],
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/*",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/nest/libp2p/integration-tests"
  ]
}